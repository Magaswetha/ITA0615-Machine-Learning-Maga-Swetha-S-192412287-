import pandas as pd
from sklearn.tree import DecisionTreeClassifier

# Create dataset
data = {
    'Income': [25000, 40000, 55000, 70000, 30000,
               80000, 45000, 65000],
    'Debt': [18000, 10000, 8000, 5000, 20000,
             3000, 12000, 6000],
    'PaymentHistory': [2, 4, 5, 5, 1, 5, 3, 4],
    'Score': ['Low', 'Medium', 'High', 'High',
             'Low', 'High', 'Medium', 'High']
}

# Convert into DataFrame
df = pd.DataFrame(data)

# Input and output
X = df[['Income', 'Debt', 'PaymentHistory']]
y = df['Score']

# Create model
model = DecisionTreeClassifier(random_state=42)

# Train model
model.fit(X, y)

# Training accuracy
accuracy = model.score(X, y)
print("Training Accuracy:", accuracy)

# New customer data
new_data = pd.DataFrame(
    [[60000, 7000, 4]],
    columns=['Income', 'Debt', 'PaymentHistory']
)

# Predict credit score
prediction = model.predict(new_data)

print("Predicted Credit Score:", prediction[0])
